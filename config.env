# StockSmart configuration
#
# Uncomment and fill in the values you need. This file is committed to the
# repo, so do NOT put credentials here. For machine-specific values (like
# email credentials), use .venv/config.env instead - it takes precedence
# and is not tracked by git.

# Micro Center store ID (see README for how to find yours). Default: 131 (Dallas)
#STORE_ID=131

# Product page URL to watch
#PRODUCT_URL=https://www.microcenter.com/product/687907/amd-ryzen-7-9800x3d-granite-ridge-am5-470ghz-8-core-boxed-processor-heatsink-not-included

# Seconds between stock checks. Default: 120
#POLL_INTERVAL=120

# --- ntfy.sh push notifications (recommended) ---
# Install the "ntfy" app on your phone, then subscribe to a new topic using a
# LONG RANDOM name (the topic name acts as your key - make it hard to guess).
# See the README for details.
#NTFY_TOPIC=replace-with-your-random-topic
# Use a self-hosted ntfy server instead of the public one:
#NTFY_URL=https://ntfy.your-domain.com

# --- Optional: legacy Gmail SMTP email channel ---
# When enabled, the program prompts for your email + Gmail App Password on
# startup (credentials are never stored).
#EMAIL_ENABLED=true
